<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumiKids">




        <activity android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"/>
        <activity
            android:name=".ui.LoginActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.RegisterActivity"
            android:screenOrientation="portrait"/>
        <activity android:name=".ui.TermsActivity"
            android:screenOrientation="portrait"/>

        <activity android:name=".ui.GameTypeActivity"
            android:screenOrientation="sensorLandscape"/>
        <activity android:name=".ui.ThemeGameActivity"
            android:screenOrientation="sensorLandscape"/>
        <activity android:name=".ui.MemoryLevelActivity"
            android:screenOrientation="sensorLandscape"/>
        <activity android:name=".ui.ObjectLevelPickerActivity"
            android:screenOrientation="sensorLandscape"/>

        <activity android:name=".minigame.objectrecognition.ui.GameActivityN1"
            android:screenOrientation="landscape"/>
        <activity android:name=".minigame.memorygame.ui.GameActivityN2"
            android:screenOrientation="landscape"/>

        <activity android:name=".ui.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>