<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAPA 1: El fondo del anillo (usamos el color secundario pero con opacidad) -->
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="3"
            android:shape="ring"
            android:thicknessRatio="14"
            android:useLevel="false">
            <!-- 20% de opacidad del blanco para que sirva de guía sobre cualquier fondo -->
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- CAPA 2: La barra de progreso (usa dinámicamente tu color_secundario) -->
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="0"
            android:toDegrees="360">
            <shape
                android:innerRadiusRatio="3"
                android:shape="ring"
                android:thicknessRatio="14"
                android:useLevel="true">

                <!-- Vinculación directa con tu atributo de color -->
                <solid android:color="?attr/color_secundario" />

            </shape>
        </rotate>
    </item>

</layer-list>