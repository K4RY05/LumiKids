<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_four">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/c_three"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_left"
            android:scaleType="fitCenter"
            android:contentDescription="Volver"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintHeight_percent="0.6"
            app:layout_constraintDimensionRatio="1:1"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"

            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintDimensionRatio="1:1"

            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="LumiKids"
            android:textColor="@color/c_one"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:maxLines="1"

            android:textSize="80sp"

            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeMaxTextSize="@dimen/title_size"
            app:autoSizeStepGranularity="2sp"

            app:layout_constraintStart_toEndOf="@id/logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSelectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Selecciona número rondas"
        android:textColor="@color/c_one"
        android:textSize="@dimen/selector_title_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <LinearLayout
        android:id="@+id/roundsSelectorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSelectTitle"
        app:layout_constraintBottom_toTopOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/btnDecrease"
            android:layout_width="@dimen/selector_arrow_size"
            android:layout_height="@dimen/selector_arrow_size"
            android:src="@drawable/ic_arrow_left"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/selector_card_size"
            android:layout_height="@dimen/selector_card_size"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <TextView
                android:id="@+id/tvRoundCount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/c_one"
                android:textSize="@dimen/selector_number_text"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btnIncrease"
            android:layout_width="@dimen/selector_arrow_size"
            android:layout_height="@dimen/selector_arrow_size"
            android:src="@drawable/ic_arrow_right"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="24dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JUGAR"
        android:textColor="@color/c_one"
        android:textSize="@dimen/button_start_text"
        android:textStyle="bold"
        android:background="@drawable/rounded_blue_bg"
        android:paddingHorizontal="@dimen/button_start_padding"
        android:paddingVertical="12dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>