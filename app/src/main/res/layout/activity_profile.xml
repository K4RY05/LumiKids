<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_four">

    <LinearLayout
        android:id="@+id/containerCenter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintWidth_max="@dimen/profile_max_width"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario"
            android:textSize="@dimen/profile_title_size"
            android:textStyle="bold"
            android:textColor="@color/c_one"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/imgUsuario"
            android:layout_width="@dimen/profile_avatar_size"
            android:layout_height="@dimen/profile_avatar_size"
            android:background="@drawable/circle_bg"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:src="@drawable/ic_user"
            android:scaleType="centerCrop"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="36dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDatos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_button_height"
            android:text="Datos Personales"
            android:textSize="@dimen/profile_label_text_size"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_button_height"
            android:text="Notificaciones"
            android:textSize="@dimen/profile_label_text_size"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTemas"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_button_height"
            android:text="Temas de colores"
            android:textSize="@dimen/profile_label_text_size"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button"
            android:layout_marginBottom="28dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_button_height"
            android:text="Cerrar Sesión"
            android:textSize="@dimen/profile_label_text_size"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:background="@drawable/bg_button"
            android:backgroundTint="#F44336"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>