<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerCaptcha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp"
        android:background="@drawable/bg_pause_container"
        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BOTÓN DE REGRESO -->
        <ImageButton
            android:id="@+id/btnCancelar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:background="?attr/color_fondo_pantalla"
            android:scaleType="centerInside"
            android:src="@drawable/ic_left"
            android:contentDescription="Cancelar y salir"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTitle"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="Verificación"
            android:textColor="?attr/color_primario"
            android:textSize="35sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancelar"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTENEDOR CAPTCHA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/captchaSectionContainer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.95">

            <!-- IMAGEN CAPTCHA -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgCaptcha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="#E0E0E0"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnRefreshCaptcha" />

            <!-- BOTÓN REFRESH -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnRefreshCaptcha"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@null"
                android:contentDescription="Cambiar captcha"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- INPUT CAPTCHA -->

        <EditText
            android:id="@+id/edtCaptchaInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:gravity="center"
            android:hint="Introduce el código"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="@android:color/black"
            android:textColorHint="#A0A0A0"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/captchaSectionContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.95" />

        <!-- BOTÓN ACEPTAR -->
        <LinearLayout
            android:id="@+id/layoutBottomForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:weightSum="1"
            app:layout_constraintTop_toBottomOf="@id/edtCaptchaInput"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.95">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptar"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Aceptar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/color_secundario"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>