<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_four">

    <FrameLayout
        android:id="@+id/leftCorner"
        android:layout_width="@dimen/esquina_ancho"
        android:layout_height="@dimen/esquina_alto"
        android:background="@drawable/bg_corner_left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icono_esquina"
            android:layout_height="@dimen/icono_esquina"
            android:layout_gravity="center"
            android:src="@drawable/ic_left"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rightCorner"
        android:layout_width="@dimen/esquina_ancho"
        android:layout_height="@dimen/esquina_alto"
        android:background="@drawable/bg_corner_right"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnPause"
            android:layout_width="@dimen/icono_esquina"
            android:layout_height="@dimen/icono_esquina"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <GridLayout
        android:id="@+id/gridMemorama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"

        app:layout_constraintTop_toBottomOf="@id/leftCorner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">



    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>