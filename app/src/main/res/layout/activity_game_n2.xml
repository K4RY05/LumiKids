<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_four">

    <!-- Botón regresar -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/ic_top_corner"
        android:layout_height="@dimen/ic_top_corner"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_left"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Botón para regresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón pausa -->
    <ImageView
        android:id="@+id/btnPause"
        android:layout_width="@dimen/ic_top_corner"
        android:layout_height="@dimen/ic_top_corner"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_pause"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Botón de pausa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid del memorama -->
    <GridLayout
        android:id="@+id/gridMemorama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>