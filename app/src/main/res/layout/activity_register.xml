<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_two">

    <!-- Header (solo decorativo) -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="180dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/bgTop"
            android:layout_width="@dimen/cloud_size"
            android:layout_height="@dimen/cloud_size"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cloud_top"
            android:contentDescription="@null" />

    </RelativeLayout>


    <!--  TARJETA  -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintWidth_max="@dimen/content_max_width"

        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="-32dp"
        android:layout_marginBottom="@dimen/card_margin_bottom"

        android:background="@drawable/bg_main_container"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- Nombre usuario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/etUsername"
            android:text="@string/register_username"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:autofillHints="username"
            android:background="@drawable/bg_input_rounded_pill"
            android:hint="@string/register_username"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="@color/c_two" />


        <!-- Correo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register_email"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input_rounded_pill"
            android:hint="@string/register_email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/c_two" />


        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register_password"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autofillHints="password"
                android:background="@drawable/bg_input_rounded_pill"
                android:hint="@string/register_password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:paddingEnd="48dp"
                android:textColor="@color/c_two" />

            <ImageButton
                android:id="@+id/ivTogglePass"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:contentDescription="@string/register_password"
                android:padding="12dp"
                android:src="@drawable/ic_eye_closed" />

        </RelativeLayout>


        <!-- Confirmar contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/register_confirm_password"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etPass2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_rounded_pill"
                android:hint="@string/register_confirm_password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:paddingEnd="48dp"
                android:textColor="@color/c_two" />

            <ImageButton
                android:id="@+id/ivTogglePass2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@null"
                android:contentDescription="@string/register_confirm_password"
                android:padding="12dp"
                android:src="@drawable/ic_eye_closed" />
        </RelativeLayout>


        <!-- Botón -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="@string/register_continue"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- TÍTULO  ===== -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="44sp"
        android:textStyle="bold"

        app:layout_constraintBottom_toTopOf="@id/card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginBottom="12dp"/>


    <!-- Nube inferior -->
    <ImageView
        android:id="@+id/bgBottom"
        android:layout_width="@dimen/cloud_size"
        android:layout_height="@dimen/cloud_size"
        android:layout_marginStart="-15dp"
        android:layout_marginBottom="-31dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cloud_bottom"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
