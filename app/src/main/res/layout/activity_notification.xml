<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/color_fondo_pantalla">

    <!-- Botón Cancelar - Tamaño adaptable -->

    <!-- Título - Tamaño de texto adaptable -->

    <ImageButton
        android:id="@+id/btnCancelar"
        android:layout_width="@dimen/notif_btn_cancel_size"
        android:layout_height="@dimen/notif_btn_cancel_size"
        android:layout_marginStart="4dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@string/desc_btn_back"
        android:scaleType="centerInside"
        android:src="@drawable/ic_left"
        android:background="@drawable/circle_bg_c_four"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Notificaciones"
        android:textColor="?attr/color_primario"
        android:textSize="@dimen/notif_title_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnCancelar"
        app:layout_constraintStart_toEndOf="@+id/btnCancelar"
        app:layout_constraintTop_toTopOf="@id/btnCancelar" />

    <!-- LISTA PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutListaPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnCancelar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            android:background="@drawable/bg_card_notificacion"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutBottomLista"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvSinNotificaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin notificaciones"
                android:textColor="?attr/color_terciario"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutBottomLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="11dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnAgregar"
                android:layout_width="@dimen/notif_btn_add_size"
                android:layout_height="@dimen/notif_btn_add_size"
                android:background="@drawable/ic_add"
                android:contentDescription="Agregar notificación" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FORMULARIO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContenedorFormulario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnCancelar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/frameContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            android:fillViewport="true"
            android:background="@drawable/bg_card_notificacion"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutBottomForm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Etiquetas usando atributo de color del tema -->
                <TextView
                    android:text="Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/color_primario"
                    android:textSize="@dimen/notif_label_text_size"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etTitulo"
                    android:hint="Ingresa un titulo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_white"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:textSize="@dimen/notif_label_text_size"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="15dp"/>

                <TextView
                    android:text="Mensaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/color_primario"
                    android:textSize="@dimen/notif_label_text_size"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_white"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:textSize="@dimen/notif_label_text_size"
                    android:gravity="top"
                    android:hint="Descripción"
                    android:padding="15dp"/>

                <TextView
                    android:text="Fecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/color_primario"
                    android:textSize="@dimen/notif_label_text_size"
                    android:textStyle="bold"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_white"
                    android:paddingHorizontal="15dp">

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:text="dd/MM/yyyy"
                        android:textColor="#212121"
                        android:textSize="@dimen/notif_label_text_size"
                        android:textColorHint="#757575"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="?attr/color_primario"/>
                </RelativeLayout>

                <TextView
                    android:text="Hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/color_primario"
                    android:textSize="@dimen/notif_label_text_size"
                    android:textStyle="bold"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_white"
                    android:paddingHorizontal="15dp">

                    <TextView
                        android:id="@+id/tvHora"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:text="00:00"
                        android:textColor="#212121"
                        android:textColorHint="#757575"
                        android:textSize="@dimen/notif_label_text_size"
                        android:clickable="true"
                        android:focusable="true"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="?attr/color_primario"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layoutBottomForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAceptar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/notif_btn_accept_height"
                android:text="Aceptar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/notif_btn_accept_text_size"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_aceptar"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>