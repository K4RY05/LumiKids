<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_four">

    <!-- Ola superior -->
    <ImageView
        android:id="@+id/waveTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/wave_top"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.28"/>

    <!-- Ola inferior -->
    <ImageView
        android:id="@+id/waveBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/wave_bottom"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.22"/>

    <!-- Sol / logo -->

    <!-- Texto -->
    <ImageView
        android:id="@+id/ivSun"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo"
        app:layout_constraintBottom_toTopOf="@id/waveBottom"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/waveTop"
        app:layout_constraintVertical_bias="0.278"
        app:layout_constraintWidth_percent="0.40" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Bienvenido"
        android:textStyle="bold"
        android:textColor="@color/c_one"
        android:textSize="32sp"
        android:gravity="center"
        android:textAlignment="center"

        android:paddingTop="6dp"
        android:paddingBottom="6dp"

        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"

        app:layout_constraintTop_toBottomOf="@id/ivSun"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
